[access]
	inheritFrom = Public-Projects
[submit]
[access "refs/meta/config"]
	label-Code-Review = -2..+2 group mdb/gerritcodereview-eng
	submit = block group Project Owners
	submit = block group google/gerritcodereview-maintainers@googlegroups.com
[access "refs/heads/*"]
	push = group mdb/gerritcodereview-eng
	create = group mdb/gerritcodereview-eng
[receive]
[access "refs/*"]
	submit = group ldap/gerritcodereview-eng
[label "Test"]
	function = MaxWithBlock
	defaultValue = 0
	allowPostSubmit = false
	ignoreSelfApproval = true
	value = -2 This shall not be submitted
	value = -1 I would prefer this is not submitted as is
	value = 0 No score
	value = +1 Looks good to me, but someone else must approve
	value = +2 Looks good to me, approved
	copyCondition = is:MIN
[submit-requirement "Code-Review"]
	description = At least one maximum vote for label 'Code-Review' is required
	submittableIf = label:Code-Review=MAX AND -label:Code-Review=MIN
	canOverrideInChildProjects = true
