[access]
	inheritFrom = Public-Projects
[submit]
	action = inherit
[access "refs/meta/config"]
	label-Code-Review = block -2..+2 group mdb/gerritcodereview-eng
	submit = block group Project Owners
	submit = block group google/gerritcodereview-maintainers@googlegroups.com
[label "Third-Party"]
  function = NoBlock
  value = -1 Fails
  value = 0 No score
  value = +1 LGTM
[submit-requirement "Third-Party"]
  description = At least one maximum vote for label 'Third-Party' is required
  submittableIf = label:Third-Party=MAX AND -label:Third-Party=MIN
